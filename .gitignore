# devmemory's own repo-local store: the binary SQLite index and the
# generated knowledge-graph diagram are regenerable (via `devmemory init` /
# `devmemory knowledge scan` / `devmemory knowledge render`) and not meant
# to be git-tracked. The Markdown decision mirror (.devmemory/records/) is
# NOT ignored -- its whole purpose, per the README, is to stay human-readable
# and git-trackable even without the CLI.
.devmemory/memory.db
.devmemory/knowledge/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
